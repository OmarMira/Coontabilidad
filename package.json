{
  "name": "coontabilidad",
  "version": "1.0.0",
  "description": "Sistema de Coontabilidad Local-First especializado para negocios en Florida, USA",
  "private": false,
  "type": "module",
  "keywords": [
    "coontabilidad",
    "contabilidad",
    "accounting",
    "erp",
    "florida",
    "local-first",
    "sqlite",
    "react",
    "typescript",
    "offline",
