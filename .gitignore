# 🔧 HERRAMIENTAS DE DESARROLLO
# ============================================

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache

# Turbo
.turbo/

# Next.js (si se usa)
.next/

# Nuxt.js (si se usa)
.nuxt/

# ============================================
# 📦 PACKAGE MANAGERS
# ============================================

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# pnpm
.pnpm-store/

# ============================================
# 🎨 ASSETS TEMPORALES
# ============================================

# Imágenes temporales
temp-images/
*.tmp.png
*.tmp.jpg

# PDFs generados temporalmente
temp-pdfs/
*.tmp.pdf

# ============================================
# 🔐 SEGURIDAD ADICIONAL
# ============================================

# Archivos de sesión
sessions/
*.session

# Cache de autenticación
.auth-cache/

# Tokens temporales
.tokens/

# ============================================
# ✅ ARCHIVOS QUE SÍ DEBEN SUBIRSE
# ============================================
# Los siguientes archivos SON SEGUROS y DEBEN subirse:
#
# ✅ .env.example - Template sin credenciales reales
# ✅ README.md - Documentación pública
# ✅ CHANGELOG.md - Historial de versiones
# ✅ package.json - Dependencias del proyecto
# ✅ tsconfig.json - Configuración de TypeScript
# ✅ vite.config.ts - Configuración de Vite
# ✅ src/ - Código fuente
# ✅ public/ - Assets públicos
# ✅ docs/ - Documentación del proyecto
# ✅ .github/ - GitHub Actions y workflows
#
# ============================================

# ============================================
# 🚨 VERIFICACIÓN DE SEGURIDAD
# ============================================
# Antes de hacer git push, ejecuta:
#
# 1. git status - Verifica qué archivos se subirán
# 2. git diff --cached - Revisa los cambios
# 3. grep -r "API_KEY\|SECRET\|PASSWORD" . - Busca credenciales
# 4. Confirma que NO aparecen archivos .db, .env, o .aex
#
# Si encuentras algo sospechoso, usa:
# git reset HEAD <archivo> - Para quitar del staging
# git rm --cached <archivo> - Para dejar de trackear
#
# ============================================

# ============================================
# 📞 SOPORTE
# ============================================
# Si tienes dudas sobre qué archivos subir:
# 1. Revisa este archivo
# 2. Consulta con el equipo de seguridad
# 3. En caso de duda, NO subas el archivo
#
# Es mejor pecar de cauteloso que exponer datos sensibles
# ============================================