# 📊 LOGS Y DEBUGGING
# ============================================

# Logs generales
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Production logs (NO subir logs con datos de clientes)
production-logs/
error-logs/
audit-logs/

# Debug files
debug/
.debug/

# ============================================
# 🚀 DEPLOYMENT
# ============================================

# Vercel
.vercel/

# Netlify
.netlify/

# AWS
.aws/
aws-config.json

# Google Cloud
.gcloud/
gcloud-config.json

# ============================================
