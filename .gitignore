# ============================================
# AccountExpress Next-Gen - .gitignore
# ============================================
# CRÍTICO: Este archivo protege datos sensibles
# NO modificar sin revisar con el equipo de seguridad
# ============================================

# ============================================
# 🔒 DATOS SENSIBLES (NUNCA SUBIR)
# ============================================

# Variables de entorno con credenciales reales
.env
.env.local
.env.production
.env.development
.env.*.local

# Base de datos SQLite con datos reales de clientes
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Backups cifrados (.aex) con datos de clientes
*.aex
backups/
backup-*.aex

# Archivos de configuración con API keys
config.local.js
config.local.ts
secrets.json

# Certificados y claves privadas
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Tokens de OAuth
oauth-tokens.json
refresh-tokens.json

# ============================================
# 📦 DEPENDENCIAS Y BUILD
# ============================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ============================================
# 🗄️ PERSISTENCIA LOCAL (OPFS/IndexedDB)
# ============================================

# IndexedDB dumps
indexeddb/
idb-dumps/

# OPFS (Origin Private File System) - metadata
.opfs/
opfs-cache/

# Temporal storage
temp/
tmp/
.tmp/
src/.translation_backups/
src/.migration_backups/

# ============================================
